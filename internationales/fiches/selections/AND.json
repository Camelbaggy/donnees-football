l":"https://fr.wikipedia.org/wiki/%C3%89quipe_d%27Andorre_de_football","licence":"CC BY-SA 4.0","licence_url":"https://creativecommons.org/licenses/by-sa/4.0/deed.fr","maj":"2026-11-26T15:46:53Z"},"maj":"2026-11-26T15:46:53Z"}